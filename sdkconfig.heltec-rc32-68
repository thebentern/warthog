# Heltec RadioCore RC32-68 (HT-RC3268), HC01 V2 with its 3.3 V FEM.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

CONFIG_MM_RESET_N=9
CONFIG_MM_WAKE=8
CONFIG_MM_BUSY=1
CONFIG_MM_SPI_SCK=11
CONFIG_MM_SPI_MISO=13
CONFIG_MM_SPI_MOSI=12
CONFIG_MM_SPI_CS=10
CONFIG_MM_SPI_IRQ=14
CONFIG_MM_POWER_ENABLE=3
CONFIG_MM_BCF_FILE="bcf_HC01_V2_3V3.mbin"

# 915 MHz SKU. The 868 MHz overlay replaces the band and region list.
CONFIG_WARTHOG_HW_REGIONS="AU,CA,JP,KR,NZ,US"
