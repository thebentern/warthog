# Warthog default sdkconfig values. These get merged into every per-env
# sdkconfig the first time PlatformIO/IDF builds.
#
# CAUTION: this file is named sdkconfig.defaults — `rm sdkconfig.*` will eat it.
# Use `rm sdkconfig.warthog-*` or similar narrow globs when scrubbing per-env
# generated sdkconfigs.

# --- Partition layout ---------------------------------------------------------
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# --- Flash size ---------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# --- ESP32-S3 native USB OTG --------------------------------------------------
# Required for TinyUSB RNDIS net device. USB-OTG only takes over the USB pins
# once tinyusb_driver_install() runs, so until then USB-Serial-JTAG carries the
# console.
CONFIG_USB_OTG_SUPPORTED=y

# --- Console -----------------------------------------------------------------
# Route the IDF console to USB-Serial-JTAG so `pio device monitor` picks up
# every ESP_LOG line until TinyUSB claims the bus.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set

# --- TinyUSB net device (NCM) + CDC console ----------------------------------
# CDC keeps a serial console after USB-OTG takes over from USB-Serial-JTAG.
# USB network class: CDC-NCM (CDC-ECM: warthog-us-ecm, sdkconfig.ecm).
#
# NCM is bound in-box by macOS, Linux (cdc_ncm), Windows 10+ (usbncm.sys) and
# iOS/iPadOS (Apple's own driver -- no dext, no MFi). ECM reached only macOS
# and Linux, which left iPads and Windows machines with no way in over the
# cable. Kconfig choice members must BOTH be written: setting only the new one
# leaves the old =y line in place and the later line wins.
CONFIG_TINYUSB_NET_MODE_ECM_RNDIS=n
CONFIG_TINYUSB_NET_MODE_NCM=y
# esp_tinyusb's defaults, pinned: the host test's TinyUSB config (usbnet_tusb/tusb_config.h) models these.
CONFIG_TINYUSB_NCM_OUT_NTB_BUFFS_COUNT=3
CONFIG_TINYUSB_NCM_IN_NTB_BUFFS_COUNT=3
CONFIG_TINYUSB_NCM_OUT_NTB_BUFF_MAX_SIZE=3200
CONFIG_TINYUSB_NCM_IN_NTB_BUFF_MAX_SIZE=3200
CONFIG_TINYUSB_TASK_STACK_SIZE=8192
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1

# --- lwIP NAT -----------------------------------------------------------------
# Phase 4: NAT downstream USB + Wi-Fi-AP traffic out via HaLow STA.
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_IPV4_NAPT_PORTMAP=y
CONFIG_LWIP_IP_FORWARD=y

# IPv4 reassembly (IDF default off): a peer with a smaller MTU, OpenMANET's bat0 at 1460 among them,
# fragments; with it off every fragment to the Warthog is dropped (measured on air 2026-10-03).
CONFIG_LWIP_IP4_REASSEMBLY=y
# At most 10 fragments held, as heap copies (main/nat_frag.c): under 16 KB for 3-4 s; Kconfig's floor.
CONFIG_LWIP_IP_REASS_MAX_PBUFS=10
# No IPv6 reassembly: with no link-local address, IDF's default IPv6 input hook drops all IPv6.

# --- Morse Micro shim pin map (XIAO + Seeed Wi-Fi HaLow add-on) --------------
CONFIG_MM_RESET_N=1
CONFIG_MM_WAKE=2
CONFIG_MM_BUSY=5
CONFIG_MM_SPI_SCK=7
CONFIG_MM_SPI_MISO=8
CONFIG_MM_SPI_MOSI=9
CONFIG_MM_SPI_CS=4
CONFIG_MM_SPI_IRQ=3

# --- Morse firmware / chip selection ------------------------------------------
CONFIG_MMHAL_CHIP_TYPE_MM6108=y
# Quectel FGH100M-H specific BCF for rated TX power.
CONFIG_MM_BCF_FILE="bcf_fgh100mhaamd.mbin"
CONFIG_MM_FW_FILE="mm6108.mbin"

# --- HaLow regulatory --------------------------------------------------------
# Without this mmhalow_init defaults to "??" → mmwlan_set_channel_list fails →
# mmwlan_boot fails → version reads come back as uninitialized garbage.
CONFIG_HALOW_COUNTRY_CODE="US"

# --- Morse packet memory pool sizes ------------------------------------------
CONFIG_MMPKTMEM_TX_POOL_N_BLOCKS=20
CONFIG_MMPKTMEM_RX_POOL_N_BLOCKS=23

# --- FreeRTOS / Morse SDK timing requirements --------------------------------
# Every Seeed mm-iot-esp32 example sets these. They are NOT optional for the
# Morse driver:
#  * FREERTOS_HZ=1000 — MMOSAL assumes a 1 ms tick. At the IDF default of 100
#    every mmosal_task_sleep()/timeout rounds to a 10 ms granularity, which
#    coarsens the chip reset pulse timing and SAE handshake timers.
#  * FREERTOS_TIMER_TASK_PRIORITY=10 — the FreeRTOS timer service task must
#    outrank every MMOSAL thread (i.e. > MMOSAL_TASK_PRI_HIGH). At the IDF
#    default of 1 it sits BELOW MMOSAL's high-priority threads, so MMOSAL
#    software timers (SAE retransmit/timeout) get starved during association.
#    See the "Timers" section of the Morse Micro mmosal API docs.
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_PRIORITY=10

# --- mbedTLS: AES key wrap (SAE / WPA3) --------------------------------------
# Seeed's sta_connect example pins this explicitly; keep it pinned so a future
# config change can't silently drop it out from under SAE association.
CONFIG_MBEDTLS_NIST_KW_C=y

# --- Log level ---------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# AES: poll rather than wait on an interrupt.
#
# With CONFIG_MBEDTLS_AES_USE_INTERRUPT the AES peripheral signals completion
# through an ISR and a semaphore, so every 16-byte block pays a task-switch.
# Measured on target: 45 us per AES block, ~1.6 ms to CCMP a 256-byte frame,
# which is ~31% of a core just to encrypt at this link's 400 kbps -- and the
# same again to decrypt. Host software CCMP (the prerequisite for per-link
# keys, SAE and OpenMANET interop) has to run per frame, so this cost is
# structural, not incidental.
CONFIG_MBEDTLS_AES_USE_INTERRUPT=n

# Core dump to flash: panics land in the coredump partition (AT+COREDUMP?
# reads the summary back after reboot) because the one USB PHY is on OTG when
# the mesh code panics, making the live panic text unreachable.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=32
# The dump runs on its own stack: with 0 it runs on the asserting one (the 'health' task has 4096 B).
CONFIG_ESP_COREDUMP_STACK_SIZE=1792
# No core-dump log lines on the panic path; they print to the USB-Serial-JTAG console.
# CONFIG_ESP_COREDUMP_LOGS is not set

# Panic prints go to the USB-Serial-JTAG console, but by the time the mesh
# stack can panic the app has moved the sole USB PHY to OTG -- the print
# blocks forever and the chip hangs with USB dead until someone pulls power.
# Reboot silently instead: the flash core dump still gets written, RTC
# survives the SW reset, and the board comes back up readable.
CONFIG_ESP_SYSTEM_PANIC_SILENT_REBOOT=y

# The task watchdog panics after 60 s (core dump, silent reboot): main/hang_guard.c subscribes
# app_main's loop; both idle tasks are watched. hang_guard.c refuses an sdkconfig without these.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

# The bootloader's RTC watchdog stays armed into app_main, which re-arms it until USB has started
# (main/boot_guard.c): a boot that stops before USB reboots instead of staying off USB.
CONFIG_BOOTLOADER_WDT_DISABLE_IN_USER_CODE=y

# L2 bridge mode (AT+MESHBRIDGE=1): USB, Wi-Fi AP and mesh as ports of one
# lwIP bridge. Off at runtime by default; this only compiles it in.
CONFIG_ESP_NETIF_BRIDGE_EN=y
CONFIG_LWIP_NUM_NETIF_CLIENT_DATA=1
